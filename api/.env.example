NODE_ENV=development
PORT=4000
APP_NAME=Hajri
# Public URL of this API (used to build absolute upload URLs)
API_URL=http://localhost:4000
# Public URL of the Next.js web app (CORS allow-list + payment return URLs)
WEB_URL=http://localhost:3000

DATABASE_URL="mysql://root@localhost:3306/hajri_node"

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
OTP_TTL_MINUTES=10
# When true (default in development) OTPs are printed to the console and "1234" always works
OTP_DEV_MODE=true
FREE_TRIAL_DAYS=7

# WhatsApp Cloud API (OTP + staff onboarding templates). Leave empty to disable sending.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0

# SMTP (welcome / subscription mails). Leave SMTP_HOST empty to log instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hajri <no-reply@hajri.app>"

# Firebase Cloud Messaging (HTTP v1). Path to a service-account JSON, or empty to disable push.
FIREBASE_SERVICE_ACCOUNT=

# Cashfree recurring subscriptions
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2023-08-01
CASHFREE_WEBHOOK_SECRET=

# Kelviq checkout
KELVIQ_API_KEY=
KELVIQ_API_URL=https://sandboxapi.kelviq.com/api/v1
KELVIQ_PLAN_IDENTIFIER=team-plan
KELVIQ_FEATURE_IDENTIFIER=team-seats-new
KELVIQ_SIMULATE=true

# Seed super admin
SUPER_ADMIN_EMAIL=superadmin@hajri.app
SUPER_ADMIN_PASSWORD=ChangeMe123!
